# No cloud LLM key is required. All AI conversation runs locally via Ollama.

# APP_URL: The URL where this application is hosted.
# Automatically set at runtime with the service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional MCP Service Keys (if using external tools / integrations)
# RUNWAY_API_KEY=
# ELEVENLABS_API_KEY=
# GOOGLE_WORKSPACE_CREDENTIALS=

# Desktop Process Lifecycle Flags
# Set to 1 or true to keep Node.js server running 24/7 even when all browser tabs close
# LUMIN_KEEP_SERVER_ALIVE=
# Set to 1 to stop Ollama daemon automatically when closing LUMIN
# LUMIN_STOP_OLLAMA_ON_SHUTDOWN=
# Set to 1 to allow start_app.bat to reuse an existing running server on port 3000
# LUMIN_REUSE_SERVER=

